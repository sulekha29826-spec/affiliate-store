{
  "rules": {
    "products": {
      ".read": true,
      ".write": true,
      ".indexOn": ["status", "categoryId", "platform", "clickCount", "createdAt"]
    },
    "categories": {
      ".read": true,
      ".write": true,
      ".indexOn": ["order", "slug"]
    },
    "banners": {
      ".read": true,
      ".write": true,
      ".indexOn": ["order", "active"]
    },
    "clicks": {
      ".read": true,
      ".write": true
    },
    "admins": {
      ".read": "auth != null",
      ".write": "root.child('admins').child(auth.uid).child('role').val() === 'superadmin'"
    },
    "settings": {
      ".read": true,
      ".write": "root.child('admins').child(auth.uid).child('role').val() === 'superadmin'"
    }
  }
}
